<section class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] shadow-2xl shadow-black/20">
  <div class="grid gap-10 px-8 py-12 md:grid-cols-[1.4fr_1fr] md:px-12 md:py-16">
    <div>
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-indigo-400/20 bg-indigo-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-indigo-300">
        Personal workspace
      </div>
      <h1 class="max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Organize your work.<br>
        <span class="text-indigo-400">Keep your focus.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-400"><%= @message %></p>
    </div>

    <div class="grid gap-3">
      <% @menus.each_with_index do |menu, index| %>
        <%= link_to menu[:path], class: "group flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/70 p-5 transition hover:-translate-y-0.5 hover:border-indigo-400/40 hover:bg-slate-900" do %>
          <div class="flex items-center gap-4">
            <span class="grid size-10 place-items-center rounded-xl bg-white/5 text-sm font-bold text-slate-400 group-hover:bg-indigo-500 group-hover:text-white"><%= format("%02d", index + 1) %></span>
            <span class="font-semibold text-slate-200 group-hover:text-white"><%= menu[:label] %></span>
          </div>
          <span class="text-xl text-slate-600 transition group-hover:translate-x-1 group-hover:text-indigo-300">→</span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
