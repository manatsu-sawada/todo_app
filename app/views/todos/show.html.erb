<div class="mx-auto max-w-2xl">
  <% if notice.present? %><p class="mb-6 rounded-xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-300"><%= notice %></p><% end %>
  <%= link_to "← Back to todos", todos_path, class: "text-sm font-medium text-indigo-300 hover:text-indigo-200" %>
  <div class="mt-6 rounded-3xl border border-white/10 bg-white/[0.04] p-8">
    <p class="mb-6 text-xs font-semibold uppercase tracking-[0.25em] text-indigo-400">Task detail</p>
    <%= render @todo %>
    <div class="mt-8 flex items-center gap-3 border-t border-white/10 pt-6">
      <%= link_to "Edit todo", edit_todo_path(@todo), class: "rounded-xl bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-400" %>
      <%= button_to "Delete", @todo, method: :delete, class: "cursor-pointer rounded-xl border border-rose-400/20 px-4 py-2.5 text-sm font-semibold text-rose-300 transition hover:bg-rose-400/10" %>
    </div>
  </div>
</div>
