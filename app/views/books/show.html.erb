<%= link_to "← Back to books", books_path, class: "text-sm font-medium text-indigo-300 hover:text-indigo-200" %>

<div class="mt-6 grid gap-6 lg:grid-cols-[1.3fr_0.7fr]">
  <section class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-indigo-400">Book record</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-white"><%= @book.title %></h1>
        <p class="mt-3 text-lg text-slate-400">by <span class="text-slate-200"><%= @book.author %></span></p>
      </div>
      <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-indigo-400/10 text-xl text-indigo-300">#</span>
    </div>
    <div class="mt-10 flex gap-3 border-t border-white/10 pt-6">
      <%= link_to "Edit book", edit_book_path(@book), class: "rounded-xl bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-400" %>
      <%= button_to "Delete", @book, method: :delete, class: "cursor-pointer rounded-xl border border-rose-400/20 px-4 py-2.5 text-sm font-semibold text-rose-300 transition hover:bg-rose-400/10" %>
    </div>
  </section>

  <aside class="rounded-3xl border border-white/10 bg-slate-900/60 p-6">
    <h2 class="text-lg font-semibold text-white">Comments</h2>
    <div class="mt-5 space-y-3">
      <% @book.comments.each do |comment| %>
        <% next if comment.new_record? %>
        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-indigo-300"><%= comment.commenter %></p>
          <p class="mt-2 text-sm leading-6 text-slate-300"><%= comment.body %></p>
        </div>
      <% end %>
    </div>

    <%= form_with model: [@book, @book.comments.build], class: "mt-6 space-y-4 border-t border-white/10 pt-6" do |form| %>
      <div>
        <%= form.label :commenter, "Name", class: "mb-2 block text-xs font-medium uppercase tracking-wider text-slate-400" %>
        <%= form.text_field :commenter, class: "w-full rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400", placeholder: "Your name" %>
      </div>
    <div>
        <%= form.label :body, "Comment", class: "mb-2 block text-xs font-medium uppercase tracking-wider text-slate-400" %>
        <%= form.text_area :body, rows: 3, class: "w-full resize-none rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400", placeholder: "Add a note..." %>
      </div>
      <%= form.submit "Post comment", class: "w-full cursor-pointer rounded-xl bg-white/10 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/15" %>
    <% end %>
  </aside>
</div>
